MONGODB_URI=mongodb://127.0.0.1:27017/next-file
# Required: run npm run auth:setup to configure the private workspace owner.
# Copy the generated values into your hosting environment for deployment.
# No sign-in or workspace access is allowed until these are configured.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
# Optional: enables AI answers. Without a key, the assistant provides keyword search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Files and note images: get these from Cloudinary Console > Settings > API Keys.
# Server-only secrets; do not prefix them with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Media Library folder for new note images (dynamic folder mode).
CLOUDINARY_FOLDER=filevault/notes
# Media Library folder for original uploaded files (authenticated raw assets).
CLOUDINARY_UPLOAD_FOLDER=filevault/uploads

# Office upload previews: install LibreOffice on the server.
# Optional override when soffice is not in a standard location or PATH.
LIBREOFFICE_PATH=
